@model ServiceRequestViewModel
<h1>Submit Service Request</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="error"></span>

    <label asp-for="CategoryId"></label>
    <select asp-for="CategoryId">
        <option value="">Select a category</option>
        @foreach (var category in ViewBag.Categories)
        {
            <option value="@category.CategoryId">@category.Name</option>
        }
    </select>
    <span asp-validation-for="CategoryId" class="error"></span>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="6"></textarea>
    <span asp-validation-for="Description" class="error"></span>

    <button type="submit">Submit Request</button>
</form>

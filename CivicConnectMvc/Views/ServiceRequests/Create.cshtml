@model ServiceRequestViewModel
<h1>Submit Service Request</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <label asp-for="Title"></label>
    <input asp-for="Title" />
    <span asp-validation-for="Title" class="error"></span>

    <label asp-for="Category"></label>
    <select asp-for="Category">
        <option>Facility Fault</option>
        <option>Damaged Equipment</option>
        <option>Security Concern</option>
        <option>IT Support</option>
        <option>Maintenance</option>
        <option>Lost Property</option>
        <option>Other</option>
    </select>

    <label asp-for="Description"></label>
    <textarea asp-for="Description" rows="6"></textarea>
    <span asp-validation-for="Description" class="error"></span>

    <button type="submit">Submit Request</button>
</form>
